{
  "schema_version": 1,
  "model": "svm",
  "algorithm_family": "kernel_approximated_linear_svm",
  "feature_columns": [
    "distance_m",
    "distance_gap_m",
    "candidate_rank",
    "arc_length_m",
    "projection_fraction",
    "heading_cos",
    "heading_valid",
    "speed_mps",
    "speed_valid",
    "time_gap_s",
    "large_gap",
    "from_out_degree",
    "to_out_degree"
  ],
  "folds_path": "results/tables/train_trip_folds.csv",
  "partitions": ["train", "student_test"],
  "model_parameters": {
    "kernel": "rbf",
    "gamma": 0.1,
    "n_components": 100,
    "C": 1.0,
    "class_weight": "balanced",
    "max_iter": 2000,
    "calibration_method": "sigmoid",
    "calibration_cv": 3,
    "random_state": 42
  },
  "max_negative_candidates_per_point": 4,
  "feature_importance": {
    "sample_rows": 50000,
    "n_repeats": 3
  },
  "outputs": {
    "directory": "results/svm",
    "model_path": "models/svm/svm_compressed9.joblib",
    "model_compression": 9
  }
}
