{
  "schema_version": 1,
  "model": "random_forest",
  "algorithm_family": "bagged_tree_classifier",
  "feature_columns": [
    "distance_m",
    "distance_gap_m",
    "candidate_rank",
    "arc_length_m",
    "projection_fraction",
    "heading_cos",
    "heading_valid",
    "speed_mps",
    "speed_valid",
    "time_gap_s",
    "large_gap",
    "from_out_degree",
    "to_out_degree"
  ],
  "folds_path": "results/tables/train_trip_folds.csv",
  "partitions": ["train", "student_test"],
  "model_parameters": {
    "n_estimators": 100,
    "max_depth": null,
    "max_features": "sqrt",
    "min_samples_leaf": 2,
    "class_weight": "balanced_subsample",
    "random_state": 42,
    "n_jobs": -1
  },
  "max_negative_candidates_per_point": 4,
  "outputs": {
    "directory": "results/random_forest",
    "model_path": "models/random_forest/random_forest.joblib"
  }
}
